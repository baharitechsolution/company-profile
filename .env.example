# ==========================================
# BAHARI TECH SOLUTION - ENVIRONMENT CONFIG
# ==========================================

# Aplikasi URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# SUPABASE / POSTGRESQL DATABASE & AUTH
# ==========================================
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Key (Opsional untuk operasi admin server berprivilese tinggi)
SUPABASE_SERVICE_ROLE_KEY=

# Backend Database URL Langsung (Opsional / Prisma / Drizzle)
DATABASE_URL=postgresql://postgres:yourpassword@db.your-project.supabase.co:5432/postgres

# Backend Email Notifikasi (Resend / SMTP)
RESEND_API_KEY=re_123456789
NOTIFICATION_EMAIL_TO=admin@baharitech.com

# WhatsApp / Telegram Webhook Notifikasi Lead Masuk (Opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
